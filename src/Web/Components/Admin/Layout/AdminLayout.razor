@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthState

@if (_authorized)
{
    <div class="d-flex" style="min-height: 100vh;">
        <nav class="bg-dark text-white p-3 flex-shrink-0" style="width: 240px;">
            <div class="mb-4">
                <h5 class="mb-0">پنل ادمین</h5>
                <small class="text-white-50">Personal Blog</small>
            </div>
            <ul class="nav flex-column gap-1">
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin">داشبورد</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/categories">دسته‌بندی‌ها</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/posts">مطالب</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/tags">برچسب‌ها</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/courses">دوره‌ها</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/projects">پروژه‌ها</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/comments">کامنت‌ها</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/contact-messages">پیام‌های تماس</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white rounded px-3 py-2" href="/admin/subscriptions">مشترکین خبرنامه</a>
                </li>
                <li class="nav-item mt-4">
                    <form method="post" action="/admin/logout">
                        <button type="submit" class="nav-link text-danger rounded px-3 py-2 border-0 bg-transparent w-100 text-start">
                            ← خروج
                        </button>
                    </form>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white-50 rounded px-3 py-2" href="/">← بازگشت به سایت</a>
                </li>
            </ul>
        </nav>
        <main class="flex-grow-1 bg-light p-4">
            @Body
        </main>
    </div>
}
else
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 100vh;">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" role="status"></div>
            <p class="text-muted">در حال بررسی دسترسی...</p>
        </div>
    </div>
}

@code {
    private bool _authorized;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        var user = authState.User;

        // چک می‌کنیم کاربر لاگین باشد
        if (user.Identity?.IsAuthenticated == true)
        {
            _authorized = true;
        }
        else
        {
            // هدایت به صفحه لاگین
            Navigation.NavigateTo("/admin/login", forceLoad: true);
        }
    }
}