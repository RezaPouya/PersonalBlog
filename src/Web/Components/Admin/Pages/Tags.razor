@page "/admin/tags"
@layout Web.Components.Admin.Layout.AdminLayout
@rendermode InteractiveServer
@using AppServices.Admin.Tags.Grid
@using AppServices.Admin.Tags.Create
@using AppServices.Admin.Tags.Update
@using AppServices.Admin.Tags.Delete
@using AppServices.Base
@using PersonalBlog.Domain.Entities.Tags.Dtos
@using Utilities.Dtos
@using Web.Components.Admin.Shared
@inject IQueryHandler<GetTagListAsGridQuery, GridDataSourceResult<TagGridDto>> GridHandler
@inject ICommandHandler<CreateTagCommand, int> CreateHandler
@inject ICommandHandler<UpdateTagCommand, int> UpdateHandler
@inject ICommandHandler<DeleteTagCommand, int> DeleteHandler
@inject IJSRuntime JS

<PageTitle>برچسب‌ها | ادمین</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">مدیریت برچسب‌ها</h1>
    <button class="btn btn-success" @onclick="ShowCreate">+ برچسب جدید</button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<DynamicGrid @ref="_grid" TItem="TagGridDto" PageSize="15" Columns="_columns" LoadData="LoadGridAsync">
    <RowActions Context="item">
        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEdit(item)">ویرایش</button>
        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteAsync(item)">حذف</button>
    </RowActions>
</DynamicGrid>

@if (_showModal)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(0,0,0,.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <EditForm Model="_form" OnValidSubmit="SubmitAsync">
                    <DataAnnotationsValidator />
                    <div class="modal-header">
                        <h5 class="modal-title">@(_form.Id == 0 ? "برچسب جدید" : "ویرایش برچسب")</h5>
                        <button type="button" class="btn-close" @onclick="() => _showModal = false"></button>
                    </div>
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(_formError))
                        {
                            <div class="alert alert-danger">@_formError</div>
                        }
                        <label class="form-label">عنوان *</label>
                        <InputText class="form-control" @bind-Value="_form.Title" />
                        <ValidationMessage For="() => _form.Title" />
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-light" @onclick="() => _showModal = false">انصراف</button>
                        <button type="submit" class="btn btn-primary" disabled="@_saving">@(_saving ? "در حال ذخیره..." : "ذخیره")</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@code {
    private DynamicGrid<TagGridDto>? _grid;
    private List<GridColumn<TagGridDto>> _columns = new();
    private string? _message;
    private bool _isError;
    private bool _showModal;
    private bool _saving;
    private string? _formError;
    private TagFormModel _form = new();

    protected override void OnInitialized()
    {
        _columns = new List<GridColumn<TagGridDto>>
        {
            new() { Header = "شناسه", PropertyName = nameof(TagGridDto.Id), Sortable = true, Width = "70px", CellText = t => t.Id.ToString() },
            new() { Header = "عنوان", PropertyName = nameof(TagGridDto.Title), Sortable = true, Filterable = true, CellText = t => t.Title },
            new() { Header = "تعداد پست", PropertyName = nameof(TagGridDto.PostsCount), Sortable = true, CellText = t => t.PostsCount.ToString() },
            new() { Header = "تاریخ ایجاد", PropertyName = nameof(TagGridDto.CreatedAt), Sortable = true, CellText = t => t.CreatedAt.ToString("yyyy/MM/dd") },
        };
    }

    private async Task<GridDataSourceResult<TagGridDto>> LoadGridAsync(GridDataSourceRequest request)
    {
        var query = new GetTagListAsGridQuery { Page = request.Page, PageSize = request.PageSize, InputParams = request.InputParams };
        return await GridHandler.Handle(query, CancellationToken.None);
    }

    private void ShowCreate()
    {
        _form = new TagFormModel();
        _formError = null;
        _showModal = true;
    }

    private void ShowEdit(TagGridDto item)
    {
        _form = new TagFormModel { Id = item.Id, Title = item.Title };
        _formError = null;
        _showModal = true;
    }

    private async Task SubmitAsync()
    {
        _saving = true;
        _formError = null;
        try
        {
            if (_form.Id == 0)
            {
                await CreateHandler.Handle(new CreateTagCommand { Title = _form.Title }, CancellationToken.None);
                _message = "برچسب ایجاد شد.";
            }
            else
            {
                await UpdateHandler.Handle(new UpdateTagCommand { Id = _form.Id, Title = _form.Title }, CancellationToken.None);
                _message = "تغییرات ذخیره شد.";
            }

            _isError = false;
            _showModal = false;
            if (_grid is not null) await _grid.RefreshAsync();
        }
        catch (Exception ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ConfirmDeleteAsync(TagGridDto item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"برچسب «{item.Title}» حذف شود؟");
        if (!confirmed) return;

        try
        {
            await DeleteHandler.Handle(new DeleteTagCommand { Id = item.Id }, CancellationToken.None);
            _message = $"برچسب «{item.Title}» حذف شد.";
            _isError = false;
            if (_grid is not null) await _grid.RefreshAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
    }

    private class TagFormModel
    {
        public int Id { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "عنوان اجباری است")]
        public string Title { get; set; } = "";
    }
}
