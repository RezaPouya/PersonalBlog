@page "/admin/posts"
@layout Web.Components.Admin.Layout.AdminLayout
@rendermode InteractiveServer
@using AppServices.Admin.Posts.Delete
@using AppServices.Admin.Posts.Grid
@using AppServices.Base
@using PersonalBlog.Domain.Entities.Posts.Dtos
@using Utilities.Dtos
@using Web.Components.Admin.Shared
@inject IQueryHandler<GetPostListAsGridQuery, GridDataSourceResult<PostGridDto>> GridHandler
@inject ICommandHandler<DeletePostCommand, int> DeleteHandler
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>مطالب | ادمین</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h1 class="h3 mb-0">مدیریت مطالب</h1>
    <a href="/admin/posts/create" class="btn btn-success">+ مطلب جدید</a>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert @(_isError ? "alert-danger" : "alert-success") alert-dismissible fade show">
        @_message
        <button type="button" class="btn-close" @onclick="() => _message = null"></button>
    </div>
}

<DynamicGrid @ref="_grid" TItem="PostGridDto" PageSize="15" Columns="_columns" LoadData="LoadGridAsync">
    <RowActions Context="item">
        <a class="btn btn-sm btn-outline-primary" href="/admin/posts/edit/@item.Id">ویرایش</a>
        <button class="btn btn-sm btn-outline-danger" @onclick="() => ConfirmDeleteAsync(item)" disabled="@_deleting">حذف</button>
    </RowActions>
</DynamicGrid>

@code {
    private DynamicGrid<PostGridDto>? _grid;
    private bool _deleting;
    private string? _message;
    private bool _isError;

    private List<GridColumn<PostGridDto>> _columns = new();

    protected override void OnInitialized()
    {
        _columns = new List<GridColumn<PostGridDto>>
        {
            new() { Header = "#", PropertyName = nameof(PostGridDto.Id), Sortable = true, Width = "60px",
                    CellText = p => p.Id.ToString() },

            new() { Header = "عنوان", PropertyName = nameof(PostGridDto.Title), Sortable = true, Filterable = true,
                    CellTemplate = p =>
                        @<div>
                            <div class="fw-semibold">@p.Title</div>
                            <small class="text-muted">@p.Slug</small>
                        </div> },

            new() { Header = "دسته‌بندی", PropertyName = nameof(PostGridDto.CategoryTitle), Sortable = true, Filterable = true,
                    CellText = p => p.CategoryTitle },

            new() { Header = "وضعیت",
                    CellTemplate = p =>
                        @<div>
                            @if (p.IsPublished)
                            {
                                <span class="badge bg-success">منتشر شده</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">پیش‌نویس</span>
                            }
                            @if (p.IsInEnglish)
                            {
                                <span class="badge bg-info text-dark">EN</span>
                            }
                        </div> },

            new() { Header = "بازدید", PropertyName = nameof(PostGridDto.ViewCount), Sortable = true,
                    CellText = p => p.ViewCount.ToString() },

            new() { Header = "تاریخ", PropertyName = nameof(PostGridDto.CreatedAt), Sortable = true,
                    CellTemplate = p => @<small>@p.CreatedAtPersian</small> },
        };
    }

    private async Task<GridDataSourceResult<PostGridDto>> LoadGridAsync(GridDataSourceRequest request)
    {
        var query = new GetPostListAsGridQuery
        {
            Page = request.Page,
            PageSize = request.PageSize,
            InputParams = request.InputParams
        };

        return await GridHandler.Handle(query, CancellationToken.None);
    }

    private async Task ConfirmDeleteAsync(PostGridDto item)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"مطلب «{item.Title}» حذف شود؟ این عملیات قابل بازگشت نیست.");
        if (!confirmed) return;

        _deleting = true;
        try
        {
            await DeleteHandler.Handle(new DeletePostCommand { Id = item.Id }, CancellationToken.None);
            _message = $"مطلب «{item.Title}» حذف شد.";
            _isError = false;
            if (_grid is not null) await _grid.RefreshAsync();
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _isError = true;
        }
        finally
        {
            _deleting = false;
        }
    }
}
