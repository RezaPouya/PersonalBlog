@using Microsoft.AspNetCore.Components.Web
@using System.Text.Json
@using AppServices.Options
@using Microsoft.Extensions.Options
@inject NavigationManager Nav
@inject IOptions<SiteSettings> SiteSettingsOptions

<PageTitle>@Title</PageTitle>
<HeadContent>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <meta name="description" content="@Description" />
    }
    <link rel="canonical" href="@Nav.Uri" />

    <meta property="og:type" content="@Type" />
    <meta property="og:title" content="@Title" />
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <meta property="og:description" content="@Description" />
    }
    <meta property="og:url" content="@Nav.Uri" />
    @if (AbsoluteImageUrl is not null)
    {
        <meta property="og:image" content="@AbsoluteImageUrl" />
        <meta name="twitter:card" content="summary_large_image" />
    }
    else
    {
        <meta name="twitter:card" content="summary" />
    }
    <meta name="twitter:title" content="@Title" />
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <meta name="twitter:description" content="@Description" />
    }

    <!-- داده‌ی ساخت‌یافته (Schema.org) برای نتایج بهتر در گوگل -->
    <script type="application/ld+json">@((MarkupString)WebsiteJsonLd)</script>
    @if (Type == "article")
    {
        <script type="application/ld+json">@((MarkupString)ArticleJsonLd)</script>
    }
</HeadContent>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = default!;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? ImageUrl { get; set; }

    /// <summary>"website" برای صفحات عادی، "article" برای صفحه‌ی پست.</summary>
    [Parameter] public string Type { get; set; } = "website";

    // فقط برای Type="article" پر می‌شوند
    [Parameter] public DateTime? PublishedAt { get; set; }
    [Parameter] public DateTime? ModifiedAt { get; set; }
    [Parameter] public string? AuthorName { get; set; }

    private static readonly JsonSerializerOptions JsonOptions = new()
    {
        // Encoder پیش‌فرض System.Text.Json کاراکترهای HTML-ناامن (< > &) را خودکار
        // اسکیپ می‌کند، پس جاسازی خروجی داخل تگ <script> امن است.
        WriteIndented = false
    };

    private string? AbsoluteImageUrl =>
        string.IsNullOrWhiteSpace(ImageUrl) ? null :
        ImageUrl.StartsWith("http", StringComparison.OrdinalIgnoreCase) ? ImageUrl :
        new Uri(new Uri(Nav.BaseUri), ImageUrl).ToString();

    private string WebsiteJsonLd
    {
        get
        {
            var site = SiteSettingsOptions.Value;
            var data = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "WebSite",
                ["name"] = site.Title,
                ["description"] = site.Description,
                ["url"] = Nav.BaseUri
            };
            return JsonSerializer.Serialize(data, JsonOptions);
        }
    }

    private string ArticleJsonLd
    {
        get
        {
            var site = SiteSettingsOptions.Value;
            var data = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Article",
                ["headline"] = Title,
                ["description"] = Description,
                ["image"] = AbsoluteImageUrl,
                ["datePublished"] = PublishedAt?.ToString("o"),
                ["dateModified"] = (ModifiedAt ?? PublishedAt)?.ToString("o"),
                ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = AuthorName ?? site.Title },
                ["publisher"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = site.Title },
                ["mainEntityOfPage"] = Nav.Uri
            };
            return JsonSerializer.Serialize(data, JsonOptions);
        }
    }
}
