@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="site-wrapper min-h-screen bg-paper dark:bg-paper-dark text-ink dark:text-ink-dark transition-colors">
    <header class="sticky top-0 z-50 bg-paper/90 dark:bg-paper-dark/90 backdrop-blur-md border-b border-line dark:border-line-dark">
        <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
            <a href="/" class="text-lg font-bold tracking-tight">وبلاگ شخصی</a>
            <nav class="hidden md:flex items-center gap-6 text-sm">
                <a href="/" class="hover:text-gold dark:hover:text-gold-dark transition">خانه</a>
                <a href="/posts" class="hover:text-gold dark:hover:text-gold-dark transition">مطالب</a>
                <a href="/about" class="hover:text-gold dark:hover:text-gold-dark transition">درباره من</a>
            </nav>
            <div class="flex items-center gap-1">
                <button type="button" @onclick="ToggleTheme" class="p-2 rounded-full hover:bg-ink/5 dark:hover:bg-ink-dark/10 transition" aria-label="تغییر قالب">
                    @if (_isDark)
                    {
                        <span>☀️</span>
                    }
                    else
                    {
                        <span>🌙</span>
                    }
                </button>
                <button type="button" @onclick="ToggleMenu" class="p-2 rounded-full hover:bg-ink/5 dark:hover:bg-ink-dark/10 md:hidden" aria-label="منو">
                    ☰
                </button>
            </div>
        </div>
        @if (_menuOpen)
        {
            <nav class="md:hidden border-t border-line dark:border-line-dark px-4 py-3 space-y-1">
                <a href="/" class="block py-2" @onclick="CloseMenu">خانه</a>
                <a href="/posts" class="block py-2" @onclick="CloseMenu">مطالب</a>
                <a href="/about" class="block py-2" @onclick="CloseMenu">درباره من</a>
            </nav>
        }
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8 min-h-[70vh]">
        @Body
    </main>

    <footer class="border-t border-line dark:border-line-dark mt-12 py-8 text-center text-sm text-ink-soft dark:text-ink-softdark">
        <div class="max-w-3xl mx-auto px-4">
            <p>© @DateTime.Now.Year وبلاگ شخصی — همه حقوق محفوظ است.</p>
        </div>
    </footer>
</div>

@code {
    private bool _isDark;
    private bool _menuOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var theme = await JS.InvokeAsync<string>("eval", "localStorage.getItem('theme') || 'light'");
                _isDark = theme == "dark";
                await ApplyThemeClass();
                StateHasChanged();
            }
            catch { }
        }
    }

    private async Task ToggleTheme()
    {
        _isDark = !_isDark;
        await JS.InvokeVoidAsync("eval", $"localStorage.setItem('theme', '{(_isDark ? "dark" : "light")}')");
        await ApplyThemeClass();
    }

    private async Task ApplyThemeClass()
    {
        await JS.InvokeVoidAsync("eval", _isDark
            ? "document.documentElement.classList.add('dark')"
            : "document.documentElement.classList.remove('dark')");
    }

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
}
