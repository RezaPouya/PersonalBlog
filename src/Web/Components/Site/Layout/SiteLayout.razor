@inherits LayoutComponentBase
@using AppServices.Site.Subscriptions
@using AppServices.Base
@inject ICommandHandler<CreateSubscriptionCommand, int> SubscriptionHandler

<div class="site-wrapper min-h-screen bg-bg dark:bg-bg-dark text-fg dark:text-fg-dark transition-colors">
    <header class="sticky top-0 z-50 bg-bg/90 dark:bg-bg-dark/90 backdrop-blur-md border-b border-line dark:border-line-dark">
        <div class="max-w-3xl mx-auto px-4 py-3 flex items-center justify-between">
            <a href="/" class="flex items-center gap-1.5 font-mono text-base font-semibold">
                <span class="text-accent dark:text-accent-dark">&gt;</span>
                <span>blog</span>
            </a>
            <nav class="hidden md:flex items-center gap-6 text-sm">
                <a href="/posts" class="hover:text-accent dark:hover:text-accent-dark transition">مطالب</a>
                <a href="/courses" class="hover:text-accent dark:hover:text-accent-dark transition">دوره‌ها</a>
                <a href="/projects" class="hover:text-accent dark:hover:text-accent-dark transition">پروژه‌ها</a>
                <a href="/about" class="hover:text-accent dark:hover:text-accent-dark transition">درباره من</a>
                <a href="/contact" class="px-3 py-1.5 rounded-lg border border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark hover:text-accent dark:hover:text-accent-dark transition">تماس</a>
            </nav>
            <div class="flex items-center gap-1">
                <a href="/search" class="p-2 rounded-full hover:bg-fg/5 dark:hover:bg-fg-dark/10 transition text-sm" aria-label="جستجو">
                    🔎
                </a>

                <!-- دکمه‌ی تغییر قالب: عمداً @onclick بلیزور استفاده نشده، یک onclick خالص HTML
                     است که مستقیم تابع جاوااسکریپت را صدا می‌زند (بدون نیاز به اتصال تعاملی
                     بلیزور). آیکون‌ها هم صرفاً با همان کلاس dark روی <html> کنترل می‌شوند
                     (dark:hidden / dark:inline)، بدون نیاز به منطق جاوااسکریپت اضافه. -->
                <button type="button" onclick="window.siteTheme && window.siteTheme.toggle()"
                        class="p-2 rounded-full hover:bg-fg/5 dark:hover:bg-fg-dark/10 transition text-sm" aria-label="تغییر قالب">
                    <span class="dark:hidden">🌙</span>
                    <span class="hidden dark:inline">☀️</span>
                </button>

                <!-- دکمه‌ی منوی موبایل: به همین دلیل این هم onclick خالص است، نه @onclick بلیزور. -->
                <button type="button" onclick="document.getElementById('mobileNav').classList.toggle('hidden')"
                        class="p-2 rounded-full hover:bg-fg/5 dark:hover:bg-fg-dark/10 md:hidden" aria-label="منو">
                    ☰
                </button>
            </div>
        </div>

        <nav id="mobileNav" class="hidden md:hidden border-t border-line dark:border-line-dark px-4 py-3 space-y-1 text-sm">
            <a href="/posts" class="block py-2">مطالب</a>
            <a href="/courses" class="block py-2">دوره‌ها</a>
            <a href="/projects" class="block py-2">پروژه‌ها</a>
            <a href="/about" class="block py-2">درباره من</a>
            <a href="/contact" class="block py-2">تماس</a>
            <a href="/search" class="block py-2">جستجو</a>
        </nav>
    </header>

    <main class="max-w-3xl mx-auto px-4 py-8 min-h-[70vh]">
        @Body
    </main>

    <footer class="border-t border-line dark:border-line-dark mt-12 py-10 text-sm text-fg-muted dark:text-fg-muted-dark">
        <div class="max-w-3xl mx-auto px-4">
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-6 pb-6 border-b border-line dark:border-line-dark">
                <span class="font-mono text-xs">مطالب جدید را در ایمیل‌تان دریافت کنید</span>
                <form class="flex gap-2 w-full sm:w-auto" @onsubmit="SubscribeAsync">
                    <input type="email" required placeholder="you@email.com" dir="ltr"
                           class="flex-grow sm:flex-grow-0 sm:w-56 rounded-lg border border-line dark:border-line-dark bg-transparent px-3 py-2 text-sm font-mono"
                           @bind="_subscribeEmail" />
                    <button type="submit" class="bg-fg dark:bg-fg-dark text-bg dark:text-bg-dark px-4 py-2 rounded-lg text-sm font-medium hover:bg-accent dark:hover:bg-accent-dark transition shrink-0" disabled="@_subscribing">
                        عضویت
                    </button>
                </form>
            </div>
            @if (!string.IsNullOrEmpty(_subscribeMessage))
            {
                <p class="text-center text-xs mb-4 @(_subscribeError ? "text-red-500" : "text-accent2 dark:text-accent2-dark")">@_subscribeMessage</p>
            }
            <p class="text-center font-mono text-xs">© @DateTime.Now.Year blog — همه حقوق محفوظ است.</p>
        </div>
    </footer>
</div>

@code {
    private string? _subscribeEmail;
    private bool _subscribing;
    private string? _subscribeMessage;
    private bool _subscribeError;

    private async Task SubscribeAsync()
    {
        if (string.IsNullOrWhiteSpace(_subscribeEmail)) return;

        _subscribing = true;
        _subscribeMessage = null;
        try
        {
            await SubscriptionHandler.Handle(new CreateSubscriptionCommand { Email = _subscribeEmail }, CancellationToken.None);
            _subscribeMessage = "عضویت شما ثبت شد. ممنون!";
            _subscribeError = false;
            _subscribeEmail = null;
        }
        catch (Exception ex)
        {
            _subscribeMessage = ex.Message;
            _subscribeError = true;
        }
        finally
        {
            _subscribing = false;
        }
    }
}
