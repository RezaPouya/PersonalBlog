@page "/courses"
@layout Web.Components.Site.Layout.SiteLayout
@rendermode InteractiveServer
@using AppServices.Site.Courses
@using AppServices.Base
@using PersonalBlog.Domain.Entities.Courses.Dtos
@using Web.Components.Site.Shared
@inject IQueryHandler<GetCoursesForSiteQuery, List<CourseSiteListDto>> CoursesHandler

<SeoHead Title="دوره‌ها" Description="مجموعه مطالبی که به‌صورت سری آموزشی مرتب شده‌اند" />

<section class="mb-8">
    <h1 class="text-2xl md:text-3xl font-bold mb-2">دوره‌ها</h1>
    <p class="text-fg-muted dark:text-fg-muted-dark text-sm">مجموعه مطالبی که به‌صورت سری آموزشی مرتب شده‌اند</p>
</section>

@if (_loading)
{
    <div class="grid sm:grid-cols-2 gap-4">
        @for (int i = 0; i < 4; i++)
        {
            <div class="animate-pulse border border-line dark:border-line-dark rounded-xl p-5">
                <div class="h-4 bg-line dark:bg-line-dark rounded w-2/3 mb-3"></div>
                <div class="h-3 bg-line dark:bg-line-dark rounded w-full"></div>
            </div>
        }
    </div>
}
else if (_courses.Count == 0)
{
    <div class="text-center py-16 text-fg-muted dark:text-fg-muted-dark border border-dashed border-line dark:border-line-dark rounded-xl font-mono text-sm">
        هنوز دوره‌ای منتشر نشده است.
    </div>
}
else
{
    <div class="grid sm:grid-cols-2 gap-4">
        @foreach (var course in _courses)
        {
            <a href="/course/@course.Slug" class="block border border-line dark:border-line-dark rounded-xl p-5 hover:border-accent dark:hover:border-accent-dark transition">
                <h3 class="font-semibold mb-2">@course.Title</h3>
                @if (!string.IsNullOrWhiteSpace(course.Description))
                {
                    <p class="text-sm text-fg-muted dark:text-fg-muted-dark leading-7 line-clamp-2 mb-3">@course.Description</p>
                }
                <div class="text-xs font-mono text-accent2 dark:text-accent2-dark">@course.PostsCount قسمت</div>
            </a>
        }
    </div>
}

@code {
    private List<CourseSiteListDto> _courses = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _courses = await CoursesHandler.Handle(new GetCoursesForSiteQuery(), CancellationToken.None);
        }
        catch
        {
            _courses = new();
        }
        finally
        {
            _loading = false;
        }
    }
}
