@page "/posts"
@layout Web.Components.Site.Layout.SiteLayout
@rendermode InteractiveServer
@using AppServices.Site.Posts
@using AppServices.Base
@using PersonalBlog.Domain.Entities.Posts.Dtos
@using Web.Components.Site.Shared
@inject IQueryHandler<GetPublishedPostsQuery, PostListPageDto> PostsHandler

<SeoHead Title="همه‌ی مطالب" Description="آرشیو کامل نوشته‌های وبلاگ" />

<section class="mb-8">
    <h1 class="text-2xl md:text-3xl font-bold mb-2">همه‌ی مطالب</h1>
    <p class="text-fg-muted dark:text-fg-muted-dark text-sm">آرشیو کامل نوشته‌های وبلاگ</p>
</section>

<PostListSection Loading="_loading" Items="_page.Items" Page="_page.Page" TotalPages="_page.TotalPages"
                 BaseUrl="/posts" EmptyText="هنوز مطلبی منتشر نشده است." />

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int? PageNumber { get; set; }

    private PostListPageDto _page = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _page = await PostsHandler.Handle(new GetPublishedPostsQuery { Page = PageNumber ?? 1, PageSize = 10 }, CancellationToken.None);
        }
        catch
        {
            _page = new PostListPageDto { Page = 1 };
        }
        finally
        {
            _loading = false;
        }
    }
}
