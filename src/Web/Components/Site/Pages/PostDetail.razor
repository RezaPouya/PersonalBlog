                            </div>
                        </div>
                        <div class="mb-3">
                            <InputTextArea class="w-full rounded-lg border border-line dark:border-line-dark bg-transparent px-3 py-2 text-sm" rows="4" placeholder="متن نظر شما" @bind-Value="_commentForm.Content" />
