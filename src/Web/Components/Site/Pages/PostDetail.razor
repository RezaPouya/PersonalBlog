                        </div>
                        <button type="submit" class="bg-fg dark:bg-fg-dark text-bg dark:text-bg-dark px-5 py-2 rounded-lg text-sm font-medium hover:bg-accent dark:hover:bg-accent-dark transition disabled:opacity-50" disabled="@_submittingComment">
