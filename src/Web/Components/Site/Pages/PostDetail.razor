}

@code {
    [Parameter] public string Slug { get; set; } = default!;

    private GetPostBySlugResult? _post;
    private List<PublicCommentDto> _comments = new();
    private bool _loading = true;

    private CreateCommentCommand _commentForm = new();
    private bool _submittingComment;
    private string? _commentMessage;
    private bool _commentIsError;
    private string _captchaQuestion = "";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _post = await PostHandler.Handle(new GetPostBySlugQuery { Slug = Slug }, CancellationToken.None);
            _comments = await CommentsHandler.Handle(new GetApprovedCommentsForPostQuery { PostId = _post.Id }, CancellationToken.None);
            await LoadCaptchaAsync();
        }
        catch
        {
            _post = null;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadCaptchaAsync()
    {
        var (captchaId, question) = await CaptchaService.GenerateChallengeAsync(CancellationToken.None);
        _commentForm.CaptchaId = captchaId;
        _captchaQuestion = question;
    }

    private async Task SubmitCommentAsync()
    {
        if (_post is null) return;

        _submittingComment = true;
        _commentMessage = null;
        try
        {
            _commentForm.PostId = _post.Id;
            await CreateCommentHandler.Handle(_commentForm, CancellationToken.None);

            _commentMessage = "نظر شما ثبت شد و پس از تأیید نمایش داده می‌شود. ممنون از مشارکت شما.";
            _commentIsError = false;
            _commentForm = new CreateCommentCommand();
            await LoadCaptchaAsync();
        }
        catch (Exception ex)
        {
            _commentMessage = ex.Message;
            _commentIsError = true;
            await LoadCaptchaAsync();
        }
        finally
        {
            _submittingComment = false;
        }
    }
}
