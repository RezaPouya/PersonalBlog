@page "/post/{Slug}"
@layout Web.Components.Site.Layout.SiteLayout
@rendermode InteractiveServer
@using AppServices.Site.Posts
@using AppServices.Base
@inject IQueryHandler<GetPostBySlugQuery, GetPostBySlugResult> PostHandler

<PageTitle>@(_post?.Title ?? "مطالب") | وبلاگ شخصی</PageTitle>

@if (_loading)
{
    <div class="animate-pulse space-y-4">
        <div class="h-3 bg-line dark:bg-line-dark rounded w-24"></div>
        <div class="h-8 bg-line dark:bg-line-dark rounded w-3/4"></div>
        <div class="h-4 bg-line dark:bg-line-dark rounded w-1/2"></div>
        <div class="h-48 bg-line dark:bg-line-dark rounded-2xl"></div>
    </div>
}
else if (_post is null)
{
    <div class="text-center py-20">
        <p class="text-ink-soft dark:text-ink-softdark mb-3">مطلب یافت نشد.</p>
        <a href="/" class="text-teal dark:text-teal-dark hover:text-gold dark:hover:text-gold-dark transition">بازگشت به خانه</a>
    </div>
}
else
{
    <article>
        <div class="mb-4 flex items-center gap-2 text-sm text-ink-soft dark:text-ink-softdark">
            <a href="/" class="hover:text-gold dark:hover:text-gold-dark transition">خانه</a>
            <span>/</span>
            <span class="text-teal dark:text-teal-dark">@_post.CategoryTitle</span>
        </div>

        <h1 class="text-2xl md:text-3xl font-bold mb-3 leading-tight">@_post.Title</h1>

        <div class="flex flex-wrap items-center gap-3 text-xs text-ink-soft dark:text-ink-softdark mb-6 pb-6 border-b border-line dark:border-line-dark">
            @if (_post.PublishedAt.HasValue)
            {
                <span>@_post.PublishedAt.Value.ToString("yyyy/MM/dd")</span>
            }
            <span>@_post.ViewCount بازدید</span>
        </div>

        @if (!string.IsNullOrEmpty(_post.CoverImageUrl))
        {
            <img src="@_post.CoverImageUrl" alt="@_post.Title" class="w-full rounded-2xl mb-8 object-cover max-h-96" />
        }

        <div class="post-content mb-8">
            @((MarkupString)_post.Content)
        </div>

        @if (_post.Tags.Any())
        {
            <div class="flex flex-wrap gap-2 pt-6 border-t border-line dark:border-line-dark">
                @foreach (var tag in _post.Tags)
                {
                    <span class="px-3 py-1 text-xs rounded-full border border-line dark:border-line-dark text-ink-soft dark:text-ink-softdark">#@tag</span>
                }
            </div>
        }
    </article>
}

@code {
    [Parameter] public string Slug { get; set; } = default!;

    private GetPostBySlugResult? _post;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        try
        {
            _post = await PostHandler.Handle(new GetPostBySlugQuery { Slug = Slug }, CancellationToken.None);
        }
        catch
        {
            _post = null;
        }
        finally
        {
            _loading = false;
        }
    }
}
