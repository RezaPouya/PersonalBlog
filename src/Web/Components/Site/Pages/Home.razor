@page "/"
@page "/home"
@layout Web.Components.Site.Layout.SiteLayout
@rendermode InteractiveServer
@using AppServices.Site.Posts
@using AppServices.Base
@using AppServices.Site.Projects
@using AppServices.Options
@using Microsoft.Extensions.Options
@using PersonalBlog.Domain.Entities.Posts.Dtos
@using PersonalBlog.Domain.Entities.Projects.Dtos
@using Web.Components.Site.Shared
@inject IQueryHandler<GetLatestPostsQuery, List<GetLatestPostsResult>> LatestPostsHandler
@inject IQueryHandler<GetProjectsForSiteQuery, List<ProjectSiteDto>> ProjectsHandler
@inject IOptions<SiteSettings> SiteSettingsOptions

<SeoHead Title="@_site.Title" Description="@_site.Description" />

<!-- ============ نوار معرفی کوتاه ============ -->
<section class="flex items-center gap-3 mb-10 pb-6 border-b border-line dark:border-line-dark">
    <img src="/uploads/profile/photo.jpg"
         onerror="this.onerror=null;this.src='/images/avatar-placeholder.svg'"
         alt="عکس پروفایل"
         class="w-12 h-12 rounded-lg object-cover border border-line dark:border-line-dark shrink-0" />
    <div class="min-w-0">
        <p class="text-sm">
            <span class="font-semibold">[نام شما]</span>
            <span class="text-fg-muted dark:text-fg-muted-dark"> — برنامه‌نویس ارشد؛ این‌جا درباره‌ی چیزهایی که می‌سازم می‌نویسم.</span>
        </p>
        <a href="/about" class="text-xs text-accent2 dark:text-accent2-dark hover:text-accent dark:hover:text-accent-dark transition">بیشتر درباره‌ی من</a>
    </div>
</section>

@if (_featuredProject is not null)
{
    <!-- ============ پروژه‌ی ویژه ============ -->
    <a href="/projects" class="block mb-10 p-4 rounded-xl border border-line dark:border-line-dark hover:border-accent dark:hover:border-accent-dark transition group">
        <div class="flex items-center justify-between gap-3">
            <div class="min-w-0">
                <div class="text-xs font-mono text-accent dark:text-accent-dark mb-1">پروژه‌ی ویژه</div>
                <div class="font-semibold group-hover:text-accent dark:group-hover:text-accent-dark transition">@_featuredProject.Title</div>
                <p class="text-sm text-fg-muted dark:text-fg-muted-dark line-clamp-1 mt-0.5">@_featuredProject.Description</p>
            </div>
            <span class="font-mono text-xs text-fg-muted dark:text-fg-muted-dark shrink-0">/projects</span>
        </div>
    </a>
}

<!-- ============ آخرین مطالب ============ -->
<section>
    <div class="flex items-baseline justify-between mb-6">
        <h1 class="text-xl font-bold">آخرین مطالب</h1>
        <a href="/posts" class="text-sm font-mono text-accent2 dark:text-accent2-dark hover:text-accent dark:hover:text-accent-dark transition">/posts</a>
    </div>

    <PostListSection Loading="_loading" Items="_posts" Page="1" TotalPages="1"
                     BaseUrl="/posts" EmptyText="هنوز مطلبی منتشر نشده است." />
</section>

@code {
    private List<PostSummaryDto> _posts = new();
    private ProjectSiteDto? _featuredProject;
    private bool _loading = true;
    private SiteSettings _site = new();

    protected override async Task OnInitializedAsync()
    {
        _site = SiteSettingsOptions.Value;

        try
        {
            var latest = await LatestPostsHandler.Handle(new GetLatestPostsQuery { Count = 10 }, CancellationToken.None);
            _posts = latest.Select(p => new PostSummaryDto
            {
                Id = p.Id,
                Title = p.Title,
                Slug = p.Slug,
                Summary = p.Summary,
                CoverImageUrl = p.CoverImageUrl,
                PublishedAt = p.PublishedAt,
                CategoryTitle = p.CategoryTitle,
                CategorySlug = p.CategorySlug,
                ViewCount = p.ViewCount
            }).ToList();
        }
        catch
        {
            _posts = new();
        }
        finally
        {
            _loading = false;
        }

        try
        {
            var projects = await ProjectsHandler.Handle(new GetProjectsForSiteQuery(), CancellationToken.None);
            _featuredProject = projects.FirstOrDefault(p => p.IsFeatured) ?? projects.FirstOrDefault();
        }
        catch
        {
            _featuredProject = null;
        }
    }
}
