@* سایدبار مشترک: دسته‌بندی‌ها، تگ‌های پرکاربرد، پرطرفدارترین‌ها *@
@inject ICategoryService CategoryService
@inject ITagService TagService
@inject IVisitService VisitService

<div class="d-flex flex-column gap-4">
    <div class="card">
        <div class="card-header fw-bold">دسته‌بندی‌ها</div>
        <ul class="list-group list-group-flush">
            @foreach (var category in _categories)
            {
                <li class="list-group-item d-flex justify-content-between">
                    <a href="/category/@category.Slug" class="text-decoration-none">@category.Title</a>
                    <span class="badge bg-light text-dark">@category.PostCount</span>
                </li>
            }
        </ul>
    </div>

    <div class="card">
        <div class="card-header fw-bold">تگ‌های پرکاربرد</div>
        <div class="card-body d-flex flex-wrap gap-2">
            @foreach (var tag in _tags)
            {
                <a href="/tag/@tag.Slug" class="badge bg-secondary-subtle text-secondary-emphasis text-decoration-none">#@tag.Title</a>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-header fw-bold">پربازدیدترین پست‌ها</div>
        <ul class="list-group list-group-flush">
            @foreach (var post in _popular)
            {
                <li class="list-group-item">
                    <a href="/post/@post.Slug" class="text-decoration-none">@post.Title</a>
                </li>
            }
        </ul>
    </div>
</div>

@code {
    private List<CategoryDto> _categories = new();
    private List<TagDto> _tags = new();
    private List<PopularPostDto> _popular = new();

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetAllAsync();
        _tags = (await TagService.GetAllAsync()).Take(15).ToList();
        _popular = await VisitService.GetMostVisitedPostsAsync(5);
    }
}
