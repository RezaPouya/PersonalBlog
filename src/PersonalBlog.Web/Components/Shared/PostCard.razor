@* کارت نمایش خلاصه‌ی پست - در صفحه‌ی اصلی، دسته‌بندی، تگ و جستجو استفاده می‌شود *@

<div class="card h-100 shadow-sm">
    @if (!string.IsNullOrWhiteSpace(Post.CoverImageUrl))
    {
        <img src="@Post.CoverImageUrl" class="card-img-top" alt="@Post.Title" style="height:180px;object-fit:cover;" />
    }
    <div class="card-body d-flex flex-column">
        <span class="badge bg-secondary-subtle text-secondary-emphasis align-self-start mb-2">@Post.CategoryTitle</span>
        <h5 class="card-title">
            <a href="/post/@Post.Slug" class="text-decoration-none text-dark">@Post.Title</a>
        </h5>
        <p class="card-text text-muted small flex-grow-1">@Post.Summary</p>
        <div class="d-flex justify-content-between align-items-center small text-muted mt-2">
            <span><i class="bi bi-eye"></i> @Post.ViewCount بازدید</span>
            <span>@(Post.PublishedAt?.ToString("yyyy/MM/dd"))</span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PostListItemDto Post { get; set; } = default!;
}
