@page "/tag/{Slug}"
@inject ITagService TagService
@inject IPostService PostService

<div class="container py-4">
    @if (_tag is null)
    {
        <p>در حال بارگذاری...</p>
    }
    else
    {
        <PageTitle>تگ: #@_tag.Title</PageTitle>
        <h1 class="mb-4">تگ: #@_tag.Title</h1>

        <div class="row">
            <div class="col-lg-8">
                <div class="row g-3">
                    @foreach (var post in _posts)
                    {
                        <div class="col-md-6"><PostCard Post="post" /></div>
                    }
                </div>
                <div class="mt-4">
                    <Pagination CurrentPage="_page" TotalPages="_totalPages" OnPageChanged="OnPageChangedAsync" />
                </div>
            </div>
            <div class="col-lg-4">
                <Sidebar />
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string Slug { get; set; } = default!;

    private TagDto? _tag;
    private List<PostListItemDto> _posts = new();
    private int _page = 1;
    private int _totalPages = 1;
    private const int PageSize = 9;

    protected override async Task OnInitializedAsync()
    {
        _tag = await TagService.GetBySlugAsync(Slug);
        if (_tag != null)
            await LoadPostsAsync();
    }

    private async Task OnPageChangedAsync(int page)
    {
        _page = page;
        await LoadPostsAsync();
    }

    private async Task LoadPostsAsync()
    {
        var (items, total) = await PostService.GetListAsync(new PostListFilterDto
        {
            Page = _page,
            PageSize = PageSize,
            TagId = _tag!.Id
        });

        _posts = items;
        _totalPages = (int)Math.Ceiling(total / (double)PageSize);
    }
}
