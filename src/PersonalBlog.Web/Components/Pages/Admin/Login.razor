@page "/admin/login"
@layout PersonalBlog.Web.Components.Layout.MainLayout
@inject NavigationManager Navigation

<PageTitle>ورود مدیر</PageTitle>

<div class="container py-5" style="max-width:420px">
    <h1 class="mb-4 text-center">ورود به پنل مدیریت</h1>

    @if (_hasError)
    {
        <div class="alert alert-danger">ایمیل یا رمز عبور اشتباه است.</div>
    }

    @* فرم ساده‌ی HTML (نه EditForm تعاملی) چون SignInAsync باید در همان
       درخواست POST سنتی (قبل از رندر تعاملی) اجرا شود. *@
    <form method="post" action="/admin/login">
        <input type="hidden" name="returnUrl" value="@_returnUrl" />
        <div class="mb-3">
            <label class="form-label">ایمیل</label>
            <input type="email" name="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">رمز عبور</label>
            <input type="password" name="password" class="form-control" required />
        </div>
        <button type="submit" class="btn btn-primary w-100">ورود</button>
    </form>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] public string? Error { get; set; }

    private string _returnUrl = "/admin";
    private bool _hasError;

    protected override void OnInitialized()
    {
        _returnUrl = string.IsNullOrWhiteSpace(ReturnUrl) ? "/admin" : ReturnUrl;
        _hasError = Error == "1";
    }
}
