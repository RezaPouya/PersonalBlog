@page "/admin/subscriptions"
@layout PersonalBlog.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@inject ISubscriptionService SubscriptionService
@rendermode InteractiveServer

<h1 class="mb-4">مشترکین خبرنامه</h1>

<div class="card mb-4">
    <div class="card-body">
        <h5>ارسال خبرنامه به همه‌ی مشترکین فعال (@_subscribers.Count نفر)</h5>
        <EditForm Model="this" OnValidSubmit="SendAsync">
            <div class="mb-2">
                <input class="form-control" placeholder="موضوع ایمیل" @bind="_subject" required />
            </div>
            <div class="mb-2">
                <textarea class="form-control" rows="5" placeholder="متن ایمیل (HTML مجاز است)" @bind="_body" required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">ارسال به همه</button>
            @if (_sent)
            {
                <span class="text-success ms-2">ارسال شد!</span>
            }
        </EditForm>
    </div>
</div>

<table class="table table-bordered bg-white">
    <thead><tr><th>ایمیل</th><th>تاریخ عضویت</th></tr></thead>
    <tbody>
        @foreach (var sub in _subscribers)
        {
            <tr><td>@sub.Email</td><td>@sub.CreatedAt.ToString("yyyy/MM/dd")</td></tr>
        }
    </tbody>
</table>

@code {
    private List<SubscriptionDto> _subscribers = new();
    private string _subject = string.Empty;
    private string _body = string.Empty;
    private bool _sent;

    protected override async Task OnInitializedAsync()
    {
        _subscribers = await SubscriptionService.GetActiveAsync();
    }

    private async Task SendAsync()
    {
        await SubscriptionService.SendNewsletterAsync(_subject, _body);
        _sent = true;
    }
}
