@page "/admin/categories"
@layout PersonalBlog.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@inject ICategoryService CategoryService
@rendermode InteractiveServer

<h1 class="mb-4">مدیریت دسته‌بندی‌ها</h1>

<div class="card mb-4">
    <div class="card-body">
        <EditForm Model="_input" OnValidSubmit="AddAsync">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-4"><input class="form-control" placeholder="عنوان" @bind="_input.Title" required /></div>
                <div class="col-md-4"><input class="form-control" placeholder="اسلاگ" @bind="_input.Slug" required /></div>
                <div class="col-md-3"><input class="form-control" placeholder="توضیحات (اختیاری)" @bind="_input.Description" /></div>
                <div class="col-md-1"><button class="btn btn-primary w-100" type="submit">افزودن</button></div>
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-bordered bg-white">
    <thead><tr><th>عنوان</th><th>اسلاگ</th><th>تعداد پست</th><th></th></tr></thead>
    <tbody>
        @foreach (var category in _categories)
        {
            <tr>
                <td>@category.Title</td>
                <td>@category.Slug</td>
                <td>@category.PostCount</td>
                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(category.Id)">حذف</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<CategoryDto> _categories = new();
    private CreateCategoryInputDto _input = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _categories = await CategoryService.GetAllAsync();

    private async Task AddAsync()
    {
        await CategoryService.CreateAsync(_input);
        _input = new();
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await CategoryService.DeleteAsync(id);
        await LoadAsync();
    }
}
