@page "/admin/courses"
@layout PersonalBlog.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@inject ICourseService CourseService
@rendermode InteractiveServer

<h1 class="mb-4">مدیریت دوره‌ها</h1>

<div class="card mb-4">
    <div class="card-body">
        <EditForm Model="_input" OnValidSubmit="AddAsync">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-3"><input class="form-control" placeholder="عنوان" @bind="_input.Title" required /></div>
                <div class="col-md-3"><input class="form-control" placeholder="اسلاگ" @bind="_input.Slug" required /></div>
                <div class="col-md-4"><input class="form-control" placeholder="توضیحات" @bind="_input.Description" /></div>
                <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">افزودن</button></div>
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-bordered bg-white">
    <thead><tr><th>عنوان</th><th>اسلاگ</th><th>تعداد پست</th><th>وضعیت</th><th></th></tr></thead>
    <tbody>
        @foreach (var course in _courses)
        {
            <tr>
                <td>@course.Title</td>
                <td>@course.Slug</td>
                <td>@course.PostCount</td>
                <td>@(course.IsPublished ? "منتشرشده" : "پیش‌نویس")</td>
                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(course.Id)">حذف</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<CourseDto> _courses = new();
    private CreateCourseInputDto _input = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _courses = await CourseService.GetAllAsync();

    private async Task AddAsync()
    {
        await CourseService.CreateAsync(_input);
        _input = new();
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await CourseService.DeleteAsync(id);
        await LoadAsync();
    }
}
