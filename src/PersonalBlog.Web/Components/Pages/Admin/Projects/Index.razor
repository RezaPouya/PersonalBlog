@page "/admin/projects"
@layout PersonalBlog.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@inject IProjectService ProjectService
@rendermode InteractiveServer

<h1 class="mb-4">مدیریت پروژه‌ها</h1>

<div class="card mb-4">
    <div class="card-body">
        <EditForm Model="_input" OnValidSubmit="AddAsync">
            <DataAnnotationsValidator />
            <div class="row g-2">
                <div class="col-md-3"><input class="form-control" placeholder="عنوان" @bind="_input.Title" required /></div>
                <div class="col-md-3"><input class="form-control" placeholder="اسلاگ" @bind="_input.Slug" required /></div>
                <div class="col-md-3"><input class="form-control" placeholder="توضیحات" @bind="_input.Description" required /></div>
                <div class="col-md-3"><input class="form-control" placeholder="تکنولوژی‌ها (با کاما)" @bind="_input.TechnologiesCsv" /></div>
                <div class="col-md-3"><input class="form-control" placeholder="لینک دمو" @bind="_input.LiveUrl" /></div>
                <div class="col-md-3"><input class="form-control" placeholder="لینک ریپازیتوری" @bind="_input.RepoUrl" /></div>
                <div class="col-md-3 form-check pt-2">
                    <input class="form-check-input" type="checkbox" @bind="_input.IsFeatured" id="featured" />
                    <label class="form-check-label" for="featured">برجسته باشد</label>
                </div>
                <div class="col-md-3"><button class="btn btn-primary w-100" type="submit">افزودن</button></div>
            </div>
        </EditForm>
    </div>
</div>

<table class="table table-bordered bg-white">
    <thead><tr><th>عنوان</th><th>تکنولوژی‌ها</th><th>برجسته</th><th></th></tr></thead>
    <tbody>
        @foreach (var project in _projects)
        {
            <tr>
                <td>@project.Title</td>
                <td>@string.Join(", ", project.Technologies)</td>
                <td>@(project.IsFeatured ? "بله" : "خیر")</td>
                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteAsync(project.Id)">حذف</button></td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<ProjectDto> _projects = new();
    private CreateProjectInputDto _input = new();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync() => _projects = await ProjectService.GetAllAsync();

    private async Task AddAsync()
    {
        await ProjectService.CreateAsync(_input);
        _input = new();
        await LoadAsync();
    }

    private async Task DeleteAsync(long id)
    {
        await ProjectService.DeleteAsync(id);
        await LoadAsync();
    }
}
