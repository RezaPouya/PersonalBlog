@page "/admin/posts/new"
@page "/admin/posts/{Id:long}"
@layout PersonalBlog.Web.Components.Layout.AdminLayout
@attribute [Authorize(Policy = "AdminOnly")]
@inject IPostService PostService
@inject ICategoryService CategoryService
@inject ITagService TagService
@inject ICourseService CourseService
@inject ICurrentAppUser CurrentAppUser
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>@(Id.HasValue ? "ویرایش پست" : "پست جدید")</PageTitle>
<h1 class="mb-4">@(Id.HasValue ? "ویرایش پست" : "پست جدید")</h1>

<EditForm Model="_input" OnValidSubmit="SubmitAsync">
    <DataAnnotationsValidator />

    <div class="row g-3">
        <div class="col-md-8">
            <div class="mb-3">
                <label class="form-label">عنوان</label>
                <input class="form-control" @bind="_input.Title" @bind:event="oninput" @onchange="OnTitleChanged" required />
            </div>
            <div class="mb-3">
                <label class="form-label">اسلاگ (URL)</label>
                <input class="form-control" @bind="_input.Slug" required />
            </div>
            <div class="mb-3">
                <label class="form-label">خلاصه</label>
                <textarea class="form-control" rows="2" @bind="_input.Summary" required></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label">محتوا (HTML - از ویرایشگر متن غنی یا Markdown-to-HTML استفاده کنید)</label>
                <textarea class="form-control font-monospace" rows="16" @bind="_input.Content" required></textarea>
                <div class="form-text">برای کد از تگ &lt;pre&gt;&lt;code class="language-csharp"&gt;...&lt;/code&gt;&lt;/pre&gt; استفاده کنید تا با Highlight.js نمایش داده شود.</div>
            </div>

            <h5 class="mt-4">SEO</h5>
            <div class="mb-3">
                <label class="form-label">Meta Title</label>
                <input class="form-control" @bind="_input.MetaTitle" />
            </div>
            <div class="mb-3">
                <label class="form-label">Meta Description</label>
                <textarea class="form-control" rows="2" @bind="_input.MetaDescription"></textarea>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">دسته‌بندی</label>
                        <select class="form-select" @bind="_input.CategoryId">
                            <option value="0">-- انتخاب کنید --</option>
                            @foreach (var category in _categories)
                            {
                                <option value="@category.Id">@category.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">دوره (اختیاری)</label>
                        <select class="form-select" @bind="_selectedCourseId">
                            <option value="0">-- بدون دوره --</option>
                            @foreach (var course in _courses)
                            {
                                <option value="@course.Id">@course.Title</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">تصویر کاور (URL)</label>
                        <input class="form-control" @bind="_input.CoverImageUrl" />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" @bind="_input.IsPublished" id="isPublished" />
                        <label class="form-check-label" for="isPublished">منتشر شود</label>
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-body">
                    <label class="form-label">تگ‌ها</label>
                    @foreach (var tag in _tags)
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   checked="@_input.TagIds.Contains(tag.Id)"
                                   @onchange="e => ToggleTag(tag.Id, (bool)e.Value!)" />
                            <label class="form-check-label">@tag.Title</label>
                        </div>
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">@(Id.HasValue ? "ذخیره‌ی تغییرات" : "ایجاد پست")</button>
        </div>
    </div>
</EditForm>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert alert-danger mt-3">@_error</div>
}

@code {
    [Parameter] public long? Id { get; set; }

    private readonly CreatePostInputDto _input = new();
    private List<CategoryDto> _categories = new();
    private List<TagDto> _tags = new();
    private List<CourseDto> _courses = new();
    private long _selectedCourseId;
    private string? _error;
    private bool _slugManuallyEdited;

    protected override async Task OnInitializedAsync()
    {
        _categories = await CategoryService.GetAllAsync();
        _tags = await TagService.GetAllAsync();
        _courses = await CourseService.GetAllAsync();

        if (Id.HasValue)
        {
            var post = await PostService.GetByIdAsync(Id.Value);
            if (post != null)
            {
                _input.Title = post.Title;
                _input.Slug = post.Slug;
                _input.Summary = post.Summary;
                _input.Content = post.Content;
                _input.CoverImageUrl = post.CoverImageUrl;
                _input.IsPublished = post.IsPublished;
                _input.CategoryId = post.CategoryId;
                _input.CourseId = post.CourseId;
                _selectedCourseId = post.CourseId ?? 0;
                _input.MetaTitle = post.MetaTitle;
                _input.MetaDescription = post.MetaDescription;
                _input.OgImageUrl = post.OgImageUrl;

                var tagIds = _tags.Where(t => post.Tags.Contains(t.Title)).Select(t => t.Id);
                _input.TagIds.AddRange(tagIds);

                _slugManuallyEdited = true; // برای پست موجود، اسلاگ را خودکار عوض نکن
            }
        }
    }

    private void OnTitleChanged()
    {
        if (!_slugManuallyEdited && !Id.HasValue)
            _input.Slug = Slugify(_input.Title);
    }

    private void ToggleTag(long tagId, bool isChecked)
    {
        if (isChecked && !_input.TagIds.Contains(tagId))
            _input.TagIds.Add(tagId);
        else if (!isChecked)
            _input.TagIds.Remove(tagId);
    }

    private async Task SubmitAsync()
    {
        try
        {
            _input.CourseId = _selectedCourseId == 0 ? null : _selectedCourseId;

            if (!await PostService.IsSlugAvailableAsync(_input.Slug, Id))
            {
                _error = "این اسلاگ قبلاً استفاده شده است.";
                return;
            }

            if (Id.HasValue)
            {
                await PostService.UpdateAsync(new UpdatePostInputDto
                {
                    Id = Id.Value,
                    Title = _input.Title,
                    Slug = _input.Slug,
                    Summary = _input.Summary,
                    Content = _input.Content,
                    CoverImageUrl = _input.CoverImageUrl,
                    IsPublished = _input.IsPublished,
                    CategoryId = _input.CategoryId,
                    CourseId = _input.CourseId,
                    TagIds = _input.TagIds,
                    MetaTitle = _input.MetaTitle,
                    MetaDescription = _input.MetaDescription,
                    OgImageUrl = _input.OgImageUrl
                }, CurrentAppUser.IsAuthenticated ? CurrentAppUser.UserId : null);
            }
            else
            {
                await PostService.CreateAsync(_input, CurrentAppUser.IsAuthenticated ? CurrentAppUser.UserId : null);
            }

            Navigation.NavigateTo("/admin/posts");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private static string Slugify(string title) =>
        title.Trim().Replace(" ", "-").ToLowerInvariant();
}
