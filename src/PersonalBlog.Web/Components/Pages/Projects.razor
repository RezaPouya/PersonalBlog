@page "/projects"
@inject IProjectService ProjectService
@rendermode InteractiveServer

<div class="container py-4">
    <h1 class="mb-4">پروژه‌ها</h1>

    <div class="mb-3 d-flex gap-2 flex-wrap">
        <button class="btn btn-sm @(_filter is null ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetFilter(null)'>همه</button>
        @foreach (var tech in _allTechnologies)
        {
            <button class="btn btn-sm @(_filter == tech ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(tech)">@tech</button>
        }
    </div>

    <div class="row g-3">
        @foreach (var project in FilteredProjects)
        {
            <div class="col-md-4">
                <div class="card h-100">
                    @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                    {
                        <img src="@project.ImageUrl" class="card-img-top" style="height:180px;object-fit:cover;" />
                    }
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">@project.Title</h5>
                        <p class="card-text text-muted small flex-grow-1">@project.Description</p>
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            @foreach (var tech in project.Technologies)
                            {
                                <span class="badge bg-light text-dark border">@tech</span>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            @if (!string.IsNullOrWhiteSpace(project.LiveUrl))
                            {
                                <a href="@project.LiveUrl" target="_blank" class="btn btn-sm btn-outline-primary">دمو</a>
                            }
                            @if (!string.IsNullOrWhiteSpace(project.RepoUrl))
                            {
                                <a href="@project.RepoUrl" target="_blank" class="btn btn-sm btn-outline-secondary">کد منبع</a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<ProjectDto> _projects = new();
    private List<string> _allTechnologies = new();
    private string? _filter;

    private IEnumerable<ProjectDto> FilteredProjects =>
        _filter is null ? _projects : _projects.Where(p => p.Technologies.Contains(_filter));

    protected override async Task OnInitializedAsync()
    {
        _projects = await ProjectService.GetAllAsync();
        _allTechnologies = _projects.SelectMany(p => p.Technologies).Distinct().OrderBy(t => t).ToList();
    }

    private void SetFilter(string? tech) => _filter = tech;
}
