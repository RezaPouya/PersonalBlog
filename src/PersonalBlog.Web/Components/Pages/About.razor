@page "/about"
@inject IOptions<SocialLinksSettings> SocialLinksOptions
@using Microsoft.Extensions.Options
@using PersonalBlog.AppServices.Options

<PageTitle>درباره‌ی من</PageTitle>

<div class="container py-4" style="max-width:700px">
    <h1 class="mb-4">درباره‌ی من</h1>
    <p>
        سلام! من یک توسعه‌دهنده‌ی نرم‌افزار هستم که در این وبلاگ تجربیات، یادداشت‌ها و
        آموزش‌های فنی خودم را به اشتراک می‌گذارم. اگر به همکاری یا مشاوره در پروژه‌ای علاقه دارید،
        از طریق فرم <a href="/contact">تماس با ما</a> در ارتباط باشید.
    </p>

    <div class="d-flex gap-3 mt-4">
        @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.GitHub))
        {
            <a href="@SocialLinksOptions.Value.GitHub" target="_blank" class="btn btn-outline-dark">
                <i class="bi bi-github"></i> گیت‌هاب
            </a>
        }
        @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.LinkedIn))
        {
            <a href="@SocialLinksOptions.Value.LinkedIn" target="_blank" class="btn btn-outline-primary">
                <i class="bi bi-linkedin"></i> لینکدین
            </a>
        }
    </div>
</div>
