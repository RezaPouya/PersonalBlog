@inherits LayoutComponentBase
@inject IOptions<SocialLinksSettings> SocialLinksOptions
@using Microsoft.Extensions.Options
@using PersonalBlog.AppServices.Options

<div class="d-flex flex-column min-vh-100">
    <header class="border-bottom bg-white sticky-top shadow-sm">
        <nav class="navbar navbar-expand-lg container">
            <a class="navbar-brand fw-bold" href="/">وبلاگ من</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item"><a class="nav-link" href="/">خانه</a></li>
                    <li class="nav-item"><a class="nav-link" href="/courses">دوره‌ها</a></li>
                    <li class="nav-item"><a class="nav-link" href="/projects">پروژه‌ها</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">درباره‌ی من</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">تماس با ما</a></li>
                </ul>
                <a href="/search" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-search"></i> جستجو
                </a>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1">
        @Body
    </main>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container d-flex flex-wrap justify-content-between align-items-center">
            <p class="mb-0">© @DateTime.Now.Year - تمام حقوق محفوظ است.</p>
            <div class="d-flex gap-3">
                @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.GitHub))
                {
                    <a href="@SocialLinksOptions.Value.GitHub" target="_blank" class="text-light"><i class="bi bi-github fs-5"></i></a>
                }
                @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.LinkedIn))
                {
                    <a href="@SocialLinksOptions.Value.LinkedIn" target="_blank" class="text-light"><i class="bi bi-linkedin fs-5"></i></a>
                }
                @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.Twitter))
                {
                    <a href="@SocialLinksOptions.Value.Twitter" target="_blank" class="text-light"><i class="bi bi-twitter-x fs-5"></i></a>
                }
                @if (!string.IsNullOrWhiteSpace(SocialLinksOptions.Value.Telegram))
                {
                    <a href="@SocialLinksOptions.Value.Telegram" target="_blank" class="text-light"><i class="bi bi-telegram fs-5"></i></a>
                }
            </div>
        </div>
    </footer>
</div>
